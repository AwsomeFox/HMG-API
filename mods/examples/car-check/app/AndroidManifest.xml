<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.hmgapi.example.carcheck"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <application android:label="Car Check" android:allowBackup="false">
        <!-- every button binding and projection event: shown as the car's own notice -->
        <receiver android:name=".Events">
            <intent-filter>
                <action android:name="dev.hmgapi.example.carcheck.KEY" />
                <action android:name="hmgapi.intent.action.PROJECTION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
